{
    "name": "@moso/eslint-config",
    "type": "module",
    "version": "3.6.2",
    "description": "@moso's sharable ESLint config",
    "author": {
        "name": "Morten Sørensen",
        "email": "morten@moso.dev",
        "url": "https://moso.dev"
    },
    "license": "BSD-3-Clause",
    "homepage": "https://github.com/moso/eslint-config",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/moso/eslint-config/eslint-config.git"
    },
    "bugs": {
        "url": "https://github.com/moso/eslint-config/issues"
    },
    "keywords": [
        "config",
        "eslint",
        "eslint-config",
        "eslint-config moso",
        "functional programming",
        "moso",
        "perfectionist",
        "stylistic",
        "typescript",
        "preact",
        "react",
        "svelte",
        "vue"
    ],
    "exports": {
        ".": "./dist/index.mjs",
        "./package.json": "./package.json"
    },
    "types": "./dist/index.d.mts",
    "files": [
        "./LICENSE",
        "./README.md",
        "./package.json",
        "dist/"
    ],
    "engines": {
        "node": "^22.23.4 || ^24.22.1 || ^26.12.1",
        "bun": ">=1.4.4"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^22.23.4 || ^24.22.1 || ^26.12.1"
        }
    },
    "scripts": {
        "build": "bun run typegen && tsdown --clean --dts",
        "build:inspector": "bun run build && bunx @eslint/config-inspector build --stats --config eslint-inspector.config.ts --out-dir ./.eslint-config-inspector",
        "dev": "bunx @eslint/config-inspector --config eslint-inspector.config.ts",
        "lint": "eslint",
        "prepack": "bun run build",
        "prepare": "bun scripts/bun-version.ts && bun run simple-git-hooks",
        "release": "bumpp --recursive && bun publish",
        "test": "vitest run",
        "test:coverage": "bun run test --coverage",
        "test:update-snapshots": "bun run test --update",
        "typecheck": "tsc --noEmit",
        "typegen": "tsx scripts/typegen.ts",
        "watch": "tsdown --watch"
    },
    "workspaces": [
        "src/rules"
    ],
    "peerDependencies": {
        "@eslint-react/eslint-plugin": "^5.30.0",
        "@next/eslint-plugin-next": "^16.4.0",
        "astro-eslint-parser": "^3.2.0",
        "eslint": "^10.10.0",
        "eslint-plugin-astro": "^3.2.1",
        "eslint-plugin-better-tailwindcss": "^4.11.0",
        "eslint-plugin-erasable-syntax-only": "^0.7.2",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "eslint-plugin-react-you-might-not-need-an-effect": "^1.2.0",
        "eslint-plugin-svelte": "^3.24.0",
        "eslint-plugin-vue": "^10.12.0",
        "eslint-plugin-vuejs-accessibility": "^2.6.0",
        "svelte-eslint-parser": "^1.10.0",
        "typescript": "^6.0.0 || ^7.0.0"
    },
    "peerDependenciesMeta": {
        "@eslint-react/eslint-plugin": {
            "optional": true
        },
        "@next/eslint-plugin-next": {
            "optional": true
        },
        "astro-eslint-parser": {
            "optional": true
        },
        "eslint-plugin-astro": {
            "optional": true
        },
        "eslint-plugin-better-tailwindcss": {
            "optional": true
        },
        "eslint-plugin-erasable-syntax-only": {
            "optional": true
        },
        "eslint-plugin-jsx-a11y": {
            "optional": true
        },
        "eslint-plugin-react-hooks": {
            "optional": true
        },
        "eslint-plugin-react-refresh": {
            "optional": true
        },
        "eslint-plugin-react-you-might-not-need-an-effect": {
            "optional": true
        },
        "eslint-plugin-svelte": {
            "optional": true
        },
        "eslint-plugin-vue": {
            "optional": true
        },
        "eslint-plugin-vuejs-accessibility": {
            "optional": true
        },
        "svelte-eslint-parser": {
            "optional": true
        },
        "typescript": {
            "optional": true
        }
    },
    "dependencies": {
        "@antfu/install-pkg": "^2.1.0",
        "@clack/prompts": "^1.9.0",
        "@e18e/eslint-plugin": "^0.8.1",
        "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@typescript-eslint/eslint-plugin": "^8.72.2",
        "@typescript-eslint/parser": "^8.72.2",
        "@typescript-eslint/utils": "^8.72.2",
        "@vitest/eslint-plugin": "^1.6.28",
        "eslint-config-flat-gitignore": "^2.4.0",
        "eslint-flat-config-utils": "^3.2.0",
        "eslint-merge-processors": "^2.0.0",
        "eslint-plugin-baseline-js": "^0.7.7",
        "eslint-plugin-de-morgan": "^2.3.0",
        "eslint-plugin-functional": "^10.0.1",
        "eslint-plugin-import-lite": "^0.6.0",
        "eslint-plugin-jsdoc": "^65.4.5",
        "eslint-plugin-jsonc": "^3.4.2",
        "eslint-plugin-n": "^18.5.0",
        "eslint-plugin-no-only-tests": "^3.4.0",
        "eslint-plugin-perfectionist": "^5.13.0",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-regexp": "^3.3.3",
        "eslint-plugin-security": "^4.2.1",
        "eslint-plugin-toml": "^1.5.0",
        "eslint-plugin-unicorn": "^79.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "eslint-plugin-yml": "^3.10.0",
        "eslint-processor-vue-blocks": "^2.0.0",
        "globals": "^17.14.0",
        "jsonc-eslint-parser": "^3.3.0",
        "local-pkg": "^2.0.0",
        "toml-eslint-parser": "^1.0.3",
        "vue-eslint-parser": "^10.4.2",
        "yaml-eslint-parser": "^2.1.0"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.30.1",
        "@eslint/compat": "^2.1.1",
        "@eslint/config-inspector": "^3.5.0",
        "@moso/eslint-plugin": "workspace:*",
        "@next/eslint-plugin-next": "^16.4.6",
        "@socketsecurity/bun-security-scanner": "^1.1.3",
        "@types/eslint-plugin-jsx-a11y": "^6.10.1",
        "@types/bun": "^1.4.4",
        "@types/node": "^26.6.6",
        "@typescript-eslint/rule-tester": "^8.72.2",
        "@vitest/coverage-v8": "^5.1.0",
        "astro-eslint-parser": "^3.2.0",
        "bumpp": "^12.3.0",
        "eslint": "^10.14.0",
        "eslint-plugin-astro": "^3.2.1",
        "eslint-plugin-better-tailwindcss": "^4.11.0",
        "eslint-plugin-erasable-syntax-only": "^0.7.2",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "eslint-plugin-react-you-might-not-need-an-effect": "^1.2.0",
        "eslint-plugin-svelte": "^3.24.1",
        "eslint-plugin-vue": "^10.12.1",
        "eslint-plugin-vuejs-accessibility": "^2.6.3",
        "eslint-typegen": "^2.3.2",
        "jiti": "^2.7.0",
        "nano-staged": "^1.0.2",
        "simple-git-hooks": "^2.14.0",
        "svelte": "^5.57.3",
        "svelte-eslint-parser": "^1.10.1",
        "ts-dedent": "^2.3.0",
        "tsdown": "^0.23.7",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "vitest": "^5.1.0"
    },
    "simple-git-hooks": {
        "pre-commit": "bunx nano-staged"
    },
    "nano-staged": {
        "*": "eslint --fix"
    }
}
